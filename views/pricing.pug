extends layout

block content

  section.pricing-hero
    .container
      .pricing-hero-content.text-center

        span.hero-kicker TECHLAUNCH PROGRAMS

        h1
          | Invest in your
          span.gradient-text future.

        p.pricing-hero-description
          | Choose the program that matches your career goals.
          | Build technical skills, strengthen your professional
          | presence, or combine both.

        .pricing-trust-row
          span ✓ Practical Learning
          span ✓ Career Focused
          span ✓ Professional Support


  section.section-space
    .container

      .pricing-section-header.text-center
        span.section-kicker SIMPLE & TRANSPARENT
        h2 Choose Your Plan
        p Start with one program or get the complete package.


      .premium-pricing-grid

        // ====================================================
        // BOOTCAMP
        // ====================================================

        .premium-pricing-card

          .pricing-card-top
            span.plan-badge TECHNICAL
            span.plan-icon ⚙

          h3 Bootcamp

          p.plan-description
            | Build practical IT and DevOps skills through
            | structured, project-based learning.

          .premium-price
            span.currency $
            strong 20
            span.price-period total

          .price-divider

          p.best-for BEST FOR
          p.best-for-text
            | Students and professionals building technical skills.

          ul.premium-features
            li
              span.feature-check ✓
              | Technical bootcamp access
            li
              span.feature-check ✓
              | DevOps fundamentals
            li
              span.feature-check ✓
              | Cloud concepts
            li
              span.feature-check ✓
              | Project-based learning
            li
              span.feature-check ✓
              | Practical guidance

          a.premium-pricing-button.outline-button(href="#contact")
            | GET BOOTCAMP
            span →

          small.plan-note
            | Start building your technical foundation.


        // ====================================================
        // MARKETING
        // ====================================================

        .premium-pricing-card

          .pricing-card-top
            span.plan-badge PROFESSIONAL
            span.plan-icon ◇

          h3 Marketing

          p.plan-description
            | Build a stronger professional presence and
            | present your technology skills effectively.

          .premium-price
            span.currency $
            strong 30
            span.price-period total

          .price-divider

          p.best-for BEST FOR
          p.best-for-text
            | Professionals ready to improve their visibility.

          ul.premium-features
            li
              span.feature-check ✓
              | Marketing support
            li
              span.feature-check ✓
              | Personal branding
            li
              span.feature-check ✓
              | Portfolio presentation
            li
              span.feature-check ✓
              | Career positioning
            li
              span.feature-check ✓
              | Professional profile strategy

          a.premium-pricing-button.outline-button(href="#contact")
            | GET MARKETING
            span →

          small.plan-note
            | Turn your skills into a stronger professional profile.


        // ====================================================
        // COMBINED LIMITED TIME OFFER
        // ====================================================

        .premium-pricing-card.featured-plan

          .featured-ribbon
            | LIMITED TIME OFFER

          .pricing-card-top
            span.plan-badge BEST VALUE
            span.plan-icon 🚀

          h3 Bootcamp + Training + Marketing

          p.plan-description
            | Get technical learning, training and professional marketing
            | together in one complete career package.

          .premium-price
            span.currency $
            strong 50
            span.price-period total

          .bundle-value
            span ✓
            | Complete Career Package

          .price-divider

          p.best-for BEST FOR
          p.best-for-text
            | Learners who want both technical skills and career visibility.

          ul.premium-features
            li
              span.feature-check ✓
              | Everything in Bootcamp
            li
              span.feature-check ✓
              | Everything in Marketing
            li
              span.feature-check ✓
              | Additional professional training
            li
              span.feature-check ✓
              | Technical project guidance
            li
              span.feature-check ✓
              | Professional portfolio support
            li
              span.feature-check ✓
              | Career positioning

          button.premium-pricing-button.primary-button(type="button")
            | LIMITED TIME OFFER
            span →

          small.plan-note
            | Get Bootcamp + Training + Marketing together for $50.


  section.section-space
    .container

      .value-section

        .value-header
          span.section-kicker WHY TECHLAUNCH
          h2 Learn. Build. Present. Grow.

          p
            | TechLaunch combines technical learning with professional
            | career development.

        .value-grid

          .value-card
            .value-number 01
            h3 Learn
            p Build practical IT and DevOps skills.

          .value-card
            .value-number 02
            h3 Build
            p Create projects that demonstrate your abilities.

          .value-card
            .value-number 03
            h3 Present
            p Build a professional technology profile.

          .value-card
            .value-number 04
            h3 Grow
            p Prepare for technology career opportunities.


  section.section-space#contact
    .container

      .pricing-cta

        .pricing-cta-content
          span.section-kicker READY TO START?
          h2 Build your next career move.
          p
            | Choose your TechLaunch program and start your journey.

        a.cta-large-button(href="/")
          | EXPLORE TECHLAUNCH
          span →

