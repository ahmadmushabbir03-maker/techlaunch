pipeline {
    agent any

    parameters {
        string(
            name: 'CI_BUILD_NUMBER',
            defaultValue: '6',
            description: 'Successful TechLaunch-CI build number'
        )

        string(
            name: 'RESOURCE_GROUP',
            defaultValue: 'rg-techlaunch',
            description: 'Azure Resource Group'
        )

        string(
            name: 'APP_NAME',
            defaultValue: 'techlaunch-app',
            description: 'Azure App Service name'
        )
    }

    environment {
        CI_JOB = 'TechLaunch-CI'
    }

    stages {

        stage('Validate CI Build Number') {
            steps {
                script {
                    if (!params.CI_BUILD_NUMBER?.trim()) {
                        error('CI_BUILD_NUMBER is required.')
                    }

                    echo "Using CI build: ${params.CI_BUILD_NUMBER}"
                }
            }
        }

        stage('Retrieve CI Artifact') {
            steps {
                script {
                    def artifactName =
                        "techlaunch-${params.CI_BUILD_NUMBER}.zip"

                    echo "Retrieving artifact: ${artifactName}"

                    copyArtifacts(
                        projectName: env.CI_JOB,
                        selector: specific(params.CI_BUILD_NUMBER),
                        filter: artifactName,
                        fingerprintArtifacts: true
                    )

                    if (!fileExists(artifactName)) {
                        error(
                            "CI artifact was not retrieved: ${artifactName}"
                        )
                    }

                    env.DEPLOY_ARTIFACT = artifactName

                    echo "CI artifact retrieved successfully."
                }
            }
        }

        stage('Azure Login') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'azure-service-principal',
                        usernameVariable: 'AZURE_CLIENT_ID',
                        passwordVariable: 'AZURE_CLIENT_SECRET'
                    ),
                    string(
                        credentialsId: 'azure-tenant-id',
                        variable: 'AZURE_TENANT_ID'
                    ),
                    string(
                        credentialsId: 'azure-subscription-id',
                        variable: 'AZURE_SUBSCRIPTION_ID'
                    )
                ]) {
                    bat '''
                        @echo off

                        echo Authenticating to Azure...

                        az login --service-principal ^
                          --username "%AZURE_CLIENT_ID%" ^
                          --password "%AZURE_CLIENT_SECRET%" ^
                          --tenant "%AZURE_TENANT_ID%"

                        if errorlevel 1 exit /b 1

                        az account set ^
                          --subscription "%AZURE_SUBSCRIPTION_ID%"

                        if errorlevel 1 exit /b 1

                        echo Azure authentication PASSED.
                    '''
                }
            }
        }
stage('Deploy Artifact') {
            steps {
                withCredentials([
                    azureServicePrincipal(
                        credentialsId: '41c41413-cef6-44ef-a611-7fad35d21b57',
                        subscriptionIdVariable: 'AZURE_SUBSCRIPTION_ID',
                        clientIdVariable: 'AZURE_CLIENT_ID',
                        clientSecretVariable: 'AZURE_CLIENT_SECRET',
                        tenantIdVariable: 'AZURE_TENANT_ID'
                    )
                ]) {
                    bat '''
                        @echo off

                        echo Deploying artifact:
                        echo %DEPLOY_ARTIFACT%

                        az webapp deploy ^
                          --resource-group "%RESOURCE_GROUP%" ^
                          --name "%APP_NAME%" ^
                          --src-path "%DEPLOY_ARTIFACT%" ^
                          --type zip

                        if errorlevel 1 exit /b 1

                        echo Azure deployment command completed.
                    '''
                }
            }
        }

        stage('Health Check') {
            steps {
                powershell '''
                    $ErrorActionPreference = "Stop"

                    $url = "https://$env:APP_NAME.azurewebsites.net/health"

                    Write-Host "Checking application health:"
                    Write-Host $url

                    Write-Host "Waiting for Azure App Service to warm up..."
                    Start-Sleep -Seconds 20

                    $success = $false

                    for ($i = 1; $i -le 10; $i++) {

                        Write-Host "Health check attempt $i of 10..."

                        try {
                            $response = Invoke-WebRequest `
                                -Uri $url `
                                -UseBasicParsing `
                                -TimeoutSec 30

                            Write-Host "HTTP Status: $($response.StatusCode)"
                            Write-Host "Response: $($response.Content)"

                            if ($response.StatusCode -eq 200) {
                                $success = $true
                                break
                            }
                        }
                        catch {
                            Write-Host "Health check attempt failed."
                            Write-Host $_.Exception.Message
                        }

                        Start-Sleep -Seconds 10
                    }

                    if (-not $success) {
                        throw "TechLaunch health check FAILED."
                    }

                    Write-Host ""
                    Write-Host "TechLaunch health check PASSED."
                '''
            }
        }
    }

    post {

        success {
            echo "============================================================"
            echo "TECHLAUNCH CD SUCCESS"
            echo "============================================================"
            echo "CI build deployed: ${params.CI_BUILD_NUMBER}"
            echo "Artifact: ${env.DEPLOY_ARTIFACT}"
            echo "Application: https://${params.APP_NAME}.azurewebsites.net"
        }

        failure {
            echo "============================================================"
            echo "TECHLAUNCH CD FAILED"
            echo "============================================================"
        }

        always {
            powershell '''
                if (Test-Path "techlaunch-*.zip") {
                    Remove-Item "techlaunch-*.zip" -Force -ErrorAction SilentlyContinue
                }
            '''
        }
    }
}